# 複製成 .env 再填（本機 launchd/Task Scheduler 部署用）。
# 雲端 GitHub Actions 部署唔使呢個檔，設定值放喺 workflow 的 env + repo secrets。
# 規則：一行一個 KEY=VALUE，唔好喺同一行加註解。

# ---- 過濾門檻 ----
TRENDS_GEO=HK
TRENDS_HOURS=6
MIN_TRAFFIC=500
INCLUDE_ENDED=0
MAX_PUSH_PER_RUN=5
DEDUP_TTL_HOURS=48
MAX_CHARS=100
STATE_FILE=state.json
PROMPT_FILE=analysis_prompt.md

# ---- 地區化（呢組唔填就係香港預設）----
# 本地時區：只影響「今日已推」嘅日界同心跳「下次約 HH:MM」
LOCAL_TZ=Asia/Hong_Kong
# 搵唔到新聞標題時嗰條 Google 新聞連結嘅語言／地區
NEWS_HL=zh-HK
NEWS_GL=HK
NEWS_CEID=HK:zh-Hant
# 官方 Trending RSS 對唔上關鍵詞就即場抓嗰個詞嘅 Google 新聞 RSS（=1 開）。
# 熱點密嘅地區（例如 US）幾乎次次對唔上，一定要開，否則模型冇新聞標題可讀。
NEWS_FALLBACK=0
NEWS_FALLBACK_MAX=3
# 心跳標題／hashtag 用嘅品牌字眼
BOT_LABEL=香港熱搜推送
BRAND_TAG=香港熱搜

# ---- 美國版（另一個群）嘅參考值，唔好同上面一齊喺同一個 .env 用；
#      雲端部署已經寫咗喺 workflow，本機想跑就另開一個 .env.us：
# TRENDS_GEO=US
# TRENDS_HOURS=6
# MIN_TRAFFIC=10000
# MAX_PUSH_PER_RUN=3
# MAX_CHARS=200
# LOCAL_TZ=America/New_York
# NEWS_HL=en-US
# NEWS_GL=US
# NEWS_CEID=US:en
# NEWS_FALLBACK=1
# BOT_LABEL=歐美熱搜推送
# BRAND_TAG=歐美熱搜
# STATE_FILE=state_us.json
# PROMPT_FILE=analysis_prompt_us.md
# TG_CONTROLS=0

# ---- LLM（OpenAI 相容雲端 API；免 24/7 開本地模型）----
MODEL_API=openai
MODEL_BASE_URL=https://api.zetaapi.ai
MODEL_NAME=gpt-5.6-luna
MODEL_API_KEY=
MODEL_TIMEOUT=60
MODEL_NUM_CTX=4096
# 想改用本地 Ollama：
# MODEL_API=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434
# MODEL_NAME=qwen2.5:7b

# ---- Telegram ----
TG_BOT_TOKEN=
TG_CHAT_ID=
# 心跳訊息 + 開關掣放邊個 chat（留空 = 同 TG_CHAT_ID）。
# 建議填「你同 bot 嘅私訊 id」或細管理群，唔好同推送目標群一齊，免洗版。
TG_ADMIN_CHAT_ID=
# 心跳（每次 run edit 一條 pinned message 顯示狀態）；=0 關閉
TG_HEARTBEAT=1
# 指令（/status /pause /resume /runnow + inline 按鈕）；=0 關閉
TG_CONTROLS=1
# 心跳顯示「下次約 HH:MM」用；跟你排程間隔（分鐘）填
NEXT_RUN_MINUTES=15
# =1 先顯示新聞連結預覽卡（預設關，Feed 較乾淨）
TG_LINK_PREVIEW=0
# 相關搜尋詞 / hashtag 最多顯示幾多個
MAX_RELATED=4

# ---- 除錯 ----
DRY_RUN=0
